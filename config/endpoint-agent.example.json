{
  "control_plane_url": "https://mira-protect.example.corp",
  "mode": "monitor",
  "poll_seconds": 2.0,
  "heartbeat_seconds": 60.0,
  "request_timeout_seconds": 5.0,
  "fail_closed": false,
  "hash_executables": true,
  "max_hash_bytes": 104857600,
  "parent_depth": 4,
  "queue_file": "/var/lib/mira-protect/telemetry-queue.jsonl",
  "max_queue_items": 1000,
  "process_names": [
    "claude",
    "codex",
    "copilot",
    "cursor",
    "gemini",
    "ollama",
    "aider",
    "opencode"
  ],
  "command_markers": [
    "@anthropic-ai/claude-code",
    "@openai/codex",
    "@google/gemini-cli",
    "gh copilot",
    "ollama run"
  ]
}

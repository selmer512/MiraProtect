# Shared endpoint token for development testing.
# Generate a long random value before using a shared control plane.
MIRA_ENDPOINT_TOKEN=replace-with-a-long-random-test-token

# Optional comma-separated exact process names to block when endpoint agents run in enforce mode.
# Start with monitor mode and validate observations before adding production deny entries.
MIRA_ENDPOINT_DENY_PROCESSES=

# Safety switch for the harmless synthetic endpoint test marker.
# Keep false in normal operation. scripts/test-linux-cli.sh enables it only for its isolated test.
MIRA_ENABLE_TEST_CONTROLS=false

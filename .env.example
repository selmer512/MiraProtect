# Shared endpoint token for controlled development testing.
# Replace this before using Mira Protect outside an isolated local lab.
MIRA_ENDPOINT_TOKEN=replace-with-a-long-random-test-token

# Version attached to every endpoint policy decision and heartbeat.
MIRA_POLICY_VERSION=2026.09.03-1

# Comma-separated exact process names. Allow wins when the same process appears in both.
# Start with monitor/guard mode before using deny entries with enforce mode.
MIRA_ENDPOINT_ALLOW_PROCESSES=
MIRA_ENDPOINT_DENY_PROCESSES=

# Providers that have completed enterprise authorization/governance review.
# Examples: anthropic,openai,github,google,local
MIRA_APPROVED_AI_PROVIDERS=

# Dedicated synthetic protection control used only by acceptance tests.
# Keep disabled in normal development deployments; the test scripts enable it explicitly.
MIRA_ENABLE_TEST_CONTROLS=false

# Offline fail-closed requires BOTH this server policy setting and MIRA_FAIL_CLOSED=true
# on the endpoint. Leave disabled until cached-policy behavior has been formally approved.
MIRA_OFFLINE_FAIL_CLOSED_ALLOWED=false

# Device health thresholds used by the control-plane CLI/API.
MIRA_DEVICE_STALE_SECONDS=180
MIRA_DEVICE_OFFLINE_SECONDS=900

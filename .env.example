# Mira Protect security profile.
# local: loopback/lab development. development: shared enterprise development. production: hardened deployment.
MIRA_SECURITY_PROFILE=local

# Administrative API credential. Required by development/production profiles.
MIRA_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token

# One-time/bootstrap token used to enroll managed endpoints.
# Generate a long random value. This token should not be stored on endpoints after enrollment.
MIRA_ENROLLMENT_TOKEN=replace-with-a-long-random-enrollment-token

# Server-side pepper for hashing per-device endpoint credentials at rest.
# Required by development/production profiles.
MIRA_TOKEN_PEPPER=replace-with-a-separate-long-random-pepper

# Legacy/shared endpoint token. Keep empty when per-device enrollment is enabled.
MIRA_ENDPOINT_TOKEN=
MIRA_ALLOW_SHARED_ENDPOINT_TOKEN=false

# Remote transport. For direct TLS, mount PEM files and set the paths below.
# If TLS is terminated by an approved reverse proxy/load balancer, set MIRA_TLS_TERMINATED_UPSTREAM=true.
MIRA_TLS_CERT_FILE=
MIRA_TLS_KEY_FILE=
MIRA_TLS_CLIENT_CA_FILE=
MIRA_TLS_REQUIRE_CLIENT_CERT=false
MIRA_TLS_TERMINATED_UPSTREAM=false

# development profile only: explicit escape hatch for isolated networks.
# production never accepts this as a substitute for TLS.
MIRA_ALLOW_INSECURE_REMOTE=false

# Central endpoint policy. Values are distributed as a versioned policy bundle and cached
# by managed agents so centrally denied process names remain discoverable while offline.
MIRA_ENDPOINT_DENY_PROCESSES=
MIRA_ENDPOINT_PROCESS_NAMES=
MIRA_ENDPOINT_COMMAND_MARKERS=
MIRA_ENDPOINT_FAIL_CLOSED=false
MIRA_ENDPOINT_POLICY_MODE=monitor
MIRA_POLICY_REFRESH_SECONDS=300

# Safety switch for the harmless synthetic endpoint test marker.
# Keep false outside isolated test harnesses.
MIRA_ENABLE_TEST_CONTROLS=false
